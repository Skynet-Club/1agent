      "objective": "Read ${workspace}/counter.rs. The function should return the last valid index of a non-empty slice. Fix the off-by-one by using `saturating_sub`, write the corrected file, and report the exact change with counter.rs as evidence.",
      "setup_files": [
        {
          "path": "counter.rs",
          "content": "pub fn last_index(len: usize) -> usize {\n    len\n}\n"
        }
      ],
      "rubric": {
        "required_conclusion_terms": [
          "saturating_sub"
        ],
        "required_sources": [
          "counter.rs"
        ],
        "required_claim_statuses": [
          "verified"
        ]
      },
      "allow_write": true,
      "expect": {
        "stop_reason": "completed",
        "answer_status": "completed",
        "min_evidence": 1,
        "min_claims": 1,
        "min_flip_conditions": 1,
        "audit_ok": true,
        "expect_checkpoint": true
      }
    },
