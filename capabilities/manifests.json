          "constraints": [],
          "required": true
        },
        {
          "verb": "check",
          "inputs": [
            "change_proposal"
          ],
          "outputs": [
            "check_report"
          ],
          "constraints": [],
          "required": true
        },
        {
          "verb": "package",
          "inputs": [
            "approval_receipt",
            "check_report"
          ],
          "outputs": [
            "release_manifest"
          ],
          "constraints": [],
          "required": true
        }
      ]
    },
    {
