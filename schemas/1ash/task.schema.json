{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1ash.dev/schemas/task/v1",
  "title": "1ASH Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "family",
    "instruction",
    "environment",
    "agent_contract",
    "budget",
    "success",
    "safety",
    "oracle",
    "baselines",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "1ash.task/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "object",
      "description": "Optional workspace fixture files written before the subject runs.",
      "additionalProperties": {
        "type": "string",
        "maxLength": 65536
      },
      "maxProperties": 16
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "network",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "network": {
          "enum": [
            "none",
            "allowlist",
            "full"
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory_mb",
            "disk_mb"
          ],
          "properties": {
            "cpu": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 128
            },
            "disk_mb": {
              "type": "integer",
              "minimum": 128
            }
          }
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "agent_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "permissions"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "write",
            "network"
          ],
          "properties": {
            "write": {
              "type": "boolean"
            },
            "network": {
              "type": "boolean"
            }
          }
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "max_steps",
        "max_tool_calls",
        "max_cost_usd"
      ],
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "weight",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "type": {
                "enum": [
                  "command",
                  "artifact",
                  "state",
                  "rubric"
                ]
              },
              "command": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "schema": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gates"
      ],
      "properties": {
        "gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noop",
        "human_time_minutes"
      ],
      "properties": {
        "noop": {
          "type": "object",
          "required": [
            "expected"
          ],
          "properties": {
            "expected": {
              "enum": [
                "pass",
                "fail"
              ]
            }
          }
        },
        "human_time_minutes": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "reviewers",
        "license"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "license": {
          "type": "string"
        },
        "contamination_notes": {
          "type": "string"
        }
      }
    }
  }
}
