{
  "schema_version": 1,
  "mapping_version": "2",
  "note": "Bindings from ontology types to current 1Agent fields. The exporter, not the runtime, owns these mappings. Every entry carries the owning layer and the mapping version; coverage is validated against ontology/types.json.",
  "bindings": [
    {
      "type": "one:Session",
      "property": "one:status",
      "source": "session.json#archived",
      "owner": "runtime",
      "mappingVersion": "2",
      "mapping": "archived ? 'archived' : 'active'"
    },
    {
      "type": "one:Run",
      "property": "one:partOfSession",
      "source": "session.json#journals",
      "owner": "runtime",
      "mappingVersion": "2",
      "mapping": "parent session of the journal path"
    },
    {
      "type": "one:Run",
      "property": "one:hasTask",
      "source": "journal#RunStarted.request",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Run",
      "property": "one:hasOutcome",
      "source": "journal#RunStopped.reason",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Task",
      "property": "one:objectiveSha256",
      "source": "journal#RunStarted.request.objective",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:ToolInvocation",
      "property": "one:name",
      "source": "journal#ToolCalled.name",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:ToolInvocation",
      "property": "one:executedBy",
      "source": "journal#ToolCalled.context",
      "owner": "runtime",
      "mappingVersion": "2",
      "mapping": "runtime actor; unknown if not journaled"
    },
    {
      "type": "one:Observation",
      "property": "one:status",
      "source": "journal#ToolObserved.status",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Answer",
      "property": "one:status",
      "source": "journal#AnswerProduced.answer.status",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Answer",
      "property": "one:conclusion",
      "source": "journal#AnswerProduced.answer.conclusion",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Decision",
      "property": "one:questionSha256",
      "source": "journal#RunStarted.request.objective",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true,
      "mapping": "question text is hashed; only the hash and character count are exported"
    },
    {
      "type": "one:Decision",
      "property": "one:status",
      "source": "journal#AnswerProduced.answer.status",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Outcome",
      "property": "one:status",
      "source": "journal#RunStopped.reason",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Option",
      "property": "one:optionIndex",
      "source": "journal#ReframeProposed.proposal.options[]",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true,
      "mapping": "array index; option text is hashed, not exported"
    },
    {
      "type": "one:Option",
      "property": "one:status",
      "source": "journal#ReframeDecided.choice",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Criterion",
      "property": "one:criterionKey",
      "source": "journal#ReframeProposed.proposal.stop_rule",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Criterion",
      "property": "one:satisfied",
      "source": "journal#ReframeProposed.proposal.stop_rule",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Proposal",
      "property": "one:status",
      "source": "journal#ToolObserved.metadata.status",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Proposal",
      "property": "one:proposalSha256",
      "source": "journal#ToolObserved.metadata.sha256",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Claim",
      "property": "one:claimText",
      "source": "journal#AnswerProduced.answer.claims[].text",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Claim",
      "property": "one:claimStatus",
      "source": "journal#AnswerProduced.answer.claims[].status",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Evidence",
      "property": "one:sourceKind",
      "source": "journal#AnswerProduced.answer.evidence[].source",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true,
      "mapping": "classify file/web/tool/model_prior/unknown"
    },
    {
      "type": "one:Evidence",
      "property": "one:sourceRef",
      "source": "journal#AnswerProduced.answer.evidence[].source",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Evidence",
      "property": "one:supportsClaim",
      "source": "journal#AnswerProduced.answer.evidence[].claim_ids",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Artifact",
      "property": "one:sha256",
      "source": "journal#ToolObserved.metadata.sha256",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true,
      "mapping": "write/edit observations; read observations P1"
    },
    {
      "type": "one:SquadMember",
      "property": "one:status",
      "source": "journal#ToolObserved.metadata.status",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:SquadMember",
      "property": "one:parentOf",
      "source": "subagent_registry#parent_session_id",
      "owner": "runtime",
      "mappingVersion": "2"
    },
    {
      "type": "one:SquadMember",
      "property": "one:spawnedBy",
      "source": "subagent_registry#spawn_call_id",
      "owner": "runtime",
      "mappingVersion": "2"
    },
    {
      "type": "one:Goal",
      "property": "one:status",
      "source": "goal_log#goals[].status",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Commitment",
      "property": "one:status",
      "source": "goal_log#commitments[].status",
      "owner": "runtime",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:ActionType",
      "property": "one:risk",
      "source": "journal#ToolObserved.metadata.risk",
      "owner": "security",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:ActionType",
      "property": "one:reversible",
      "source": "journal#ToolObserved.metadata.reversible",
      "owner": "security",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:ActionType",
      "property": "one:hasAccessPolicy",
      "source": "journal#ToolObserved.metadata.authority_profile_id",
      "owner": "security",
      "mappingVersion": "2",
      "required": true,
      "mapping": "present when an Authority profile decided the action"
    },
    {
      "type": "one:ActionInvocation",
      "property": "one:status",
      "source": "journal#ToolObserved.metadata.action_id",
      "owner": "security",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:ActionInvocation",
      "property": "one:hasPolicyDecision",
      "source": "journal#ToolObserved.metadata.policy_outcome",
      "owner": "security",
      "mappingVersion": "2"
    },
    {
      "type": "one:PolicyDecision",
      "property": "one:outcome",
      "source": "journal#ToolObserved.metadata.policy_outcome",
      "owner": "security",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:Approval",
      "property": "one:status",
      "source": "journal#ToolObserved.metadata.approval_card_id",
      "owner": "security",
      "mappingVersion": "2",
      "required": true,
      "mapping": "recorded when a card id is present"
    },
    {
      "type": "one:DataBinding",
      "property": "one:boundTo",
      "source": "ontology/types.json#types",
      "owner": "ontology",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:DataBinding",
      "property": "one:sourcePath",
      "source": "ontology/bindings.json#bindings[].source",
      "owner": "ontology",
      "mappingVersion": "2",
      "required": true
    },
    {
      "type": "one:DataBinding",
      "property": "one:mappingVersion",
      "source": "ontology/bindings.json#mapping_version",
      "owner": "ontology",
      "mappingVersion": "2",
      "required": true
    }
  ]
}
